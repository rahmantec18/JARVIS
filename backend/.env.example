# J.A.R.V.I.S. Environment Configuration

# AI Provider Configuration
# Options: 'gemini', 'openai', 'openai-compatible', 'mock'
AI_PROVIDER=gemini
AI_MODEL=gemini-2.5-flash
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_BASE_URL=

# Spotify Integration (Optional for official API playback)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Backend Server Configuration
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
DATABASE_URL=sqlite+aiosqlite:///./jarvis.db

# Windows Desktop Agent Connection
DESKTOP_AGENT_ENABLED=true
DESKTOP_AGENT_URL=http://127.0.0.1:8001
DESKTOP_AGENT_TOKEN=jarvis-desktop-secret-token-change-in-production

# Web Search Configuration (Optional DuckDuckGo / Bing / Serper)
SEARCH_PROVIDER=duckduckgo
SEARCH_API_KEY=

# Security & CORS
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
